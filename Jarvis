# ---------- MEMORY ----------
def load_memory():
    if os.path.exists(MEMORY_FILE):
        try:
            with open(MEMORY_FILE, "r", encoding="utf-8") as f:
                return json.load(f)
        except (json.JSONDecodeError, OSError):
            pass
    return {"notes": [], "tasks": [], "reminders": []}

memory = load_memory()

def save_memory():
    with open(MEMORY_FILE, "w", encoding="utf-8") as f:
        json.dump(memory, f, indent=2, ensure_ascii=False)

# ---------- SAFE CALCULATOR ----------
OPS = {
    ast.Add: operator.add,
    ast.Sub: operator.sub,
    ast.Mult: operator.mul,
    ast.Div: operator.truediv,
    ast.Pow: operator.pow,
    ast.Mod: operator.mod,
    ast.USub: operator.neg,
    ast.UAdd: operator.pos,
}

def calculate(node):
    if isinstance(node, ast.Expression):
        return calculate(node.body)

    if isinstance(node, ast.Constant) and type(node.value) in (int, float):
        return node.value

    if isinstance(node, ast.BinOp) and type(node.op) in OPS:
        left = calculate(node.left)
        right = calculate(node.right)

        if isinstance(node.op, ast.Pow) and abs(right) > 10:
            raise ValueError("Exponent too large")

        result = OPS[type(node.op)](left, right)
        if abs(result) > 1e100:
            raise ValueError("Result too large")
        return result

    if isinstance(node, ast.UnaryOp) and type(node.op) in OPS:
        return OPS[type(node.op)](calculate(node.operand))

    raise ValueError("Unsupported calculation")

def safe_calculate(expression):
    tree = ast.parse(expression, mode="eval")
    return calculate(tree)

# ---------- ASSISTANT BRAIN ----------
def assistant_reply(text):
    command = text.strip()
    lower = command.lower()

    if not command:
        return "Please enter a message."

    if lower in ("hi", "hello", "hey", "hi life ai"):
        return "Hello! How can I help you today?"

    if "your name" in lower:
        return "I am LIFE AI, your personal assistant."

    if "time" in lower:
        return "Current time: " + datetime.datetime.now().strftime("%I:%M %p")

    if "date" in lower or "today" == lower:
        return "Today's date: " + datetime.datetime.now().strftime("%d-%m-%Y")

    # Save personal notes
    if lower.startswith("remember "):
        note = command[9:].strip()
        if note:
            memory["notes"].append({
                "text": note,
                "created": datetime.datetime.now().isoformat()
            })
            save_memory()
            return "Saved to personal memory."

    if "show memory" in lower or "my notes" in lower:
        notes = memory["notes"]
        if not notes:
            return "Your memory is empty."
        return "\n".join(
            f"{i + 1}. {item['text']}"
            for i, item in enumerate(notes)
        )

    # Tasks
    if lower.startswith("add task "):
        task = command[9:].strip()
        if task:
            memory["tasks"].append({
                "text": task,
                "done": False
            })
            save_memory()
            return "Task added: " + task

    if lower == "show tasks":
        tasks = memory["tasks"]
        if not tasks:
            return "You have no tasks."
        return "\n".join(
            f"{i + 1}. [{'x' if t['done'] else ' '}] {t['text']}"
            for i, t in enumerate(tasks)
        )

    if lower.startswith("complete task "):
        try:
            index = int(lower.replace("complete task ", "")) - 1
            if 0 <= index < len(memory["tasks"]):
                memory["tasks"][index]["done"] = True
                save_memory()
                return "Task completed."
            return "Task number not found."
        except ValueError:
            return "Use: complete task 1"

    # Calculations
    if lower.startswith("calculate "):
        expression = command[10:].strip()
        try:
            return "Result: " + str(safe_calculate(expression))
        except Exception:
            return "Invalid calculation. Example: calculate 25 * (4 + 2)"

    if lower == "help":
        return (
            "Try these commands:\n"
            "• hello\n"
            "• what is the time\n"
            "• what is today's date\n"
            "• remember buy a laptop\n"
            "• show memory\n"
            "• add task finish assignment\n"
            "• show tasks\n"
            "• complete task 1\n"
            "• calculate 25 * 4\n"
            "• help"
        )

    return (
        "I don't have an answer for that yet.\n"
        "This starter version uses simple command matching. "
        "Connect an AI model API to enable intelligent conversations."
    )

