    bg=BG_DARK
)
subtitle.pack(anchor="w", pady=(2, 0))

# Chat Container Frame
chat_container = tk.Frame(root, bg=SURFACE_DARK, highlightbackground=PANEL_DARK, highlightthickness=1)
chat_container.pack(fill=tk.BOTH, expand=True, padx=20, pady=(0, 16))

chat = scrolledtext.ScrolledText(
    chat_container,
    wrap=tk.WORD,
    font=("Segoe UI", 11),
    bg=SURFACE_DARK,
    fg=TEXT_PRIMARY,
    insertbackground=TEXT_PRIMARY,
    borderwidth=0,
    highlightthickness=0,
    padx=16,
    pady=16,
    state=tk.DISABLED
)
chat.pack(fill=tk.BOTH, expand=True)

# Configure text tags for styled bubbles
chat.tag_config("user", foreground="#818cf8", font=("Segoe UI", 11, "bold"))
chat.tag_config("ai", foreground="#34d399", font=("Segoe UI", 11, "bold"))
chat.tag_config("body", foreground=TEXT_PRIMARY, font=("Segoe UI", 11))

def display_message(sender, message):
    chat.configure(state=tk.NORMAL)
    tag = "user" if sender == "You" else "ai"
    chat.insert(tk.END, f"{sender}\n", tag)
    chat.insert(tk.END, f"{message}\n\n", "body")
    chat.configure(state=tk.DISABLED)
    chat.see(tk.END)

def send_message(event=None):
    text = entry.get().strip()
    if not text:
        return

    entry.delete(0, tk.END)
    display_message("You", text)

    def process():
        reply = assistant_reply(text)
        root.after(0, lambda: display_message("LIFE AI", reply))

    threading.Thread(target=process, daemon=True).start()

# Input Bar Frame
entry_frame = tk.Frame(root, bg=PANEL_DARK, padx=12, pady=10)
entry_frame.pack(fill=tk.X, padx=20, pady=(0, 20))

entry = tk.Entry(
    entry_frame,
    font=("Segoe UI", 12),
    bg=PANEL_DARK,
    fg=TEXT_PRIMARY,
    insertbackground=TEXT_PRIMARY,
    borderwidth=0,
    highlightthickness=0
)
entry.pack(side=tk.LEFT, fill=tk.X, expand=True, ipdy=6, padx=(4, 12))
entry.bind("<Return>", send_message)

send_button = tk.Button(
    entry_frame,
    text="Send ➔",
    font=("Segoe UI", 10, "bold"),
    bg=ACCENT_COLOR,
    fg="#ffffff",
    activebackground=ACCENT_HOVER,
    activeforeground="#ffffff",
    relief=tk.FLAT,
    cursor="hand2",
    command=send_message,
    padx=16,
    pady=6
)
send_button.pack(side=tk.RIGHT)

display_message(
    "LIFE AI",
    "Welcome! Type 'help' to see available commands."
)

root.mainloop()
